        <mxCell id="software" value="&lt;b&gt;SoftwareVersion 软件版本&lt;/b&gt;&lt;hr&gt;osVersion&lt;br&gt;aiVersion&lt;br&gt;asrVersion / ttsVersion&lt;br&gt;motionVersion / visionVersion&lt;br&gt;emotionVersion&lt;br&gt;otaVersion / cloudVersion" style="shape=umlClass;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="760" y="40" width="270" height="200" as="geometry" /></mxCell>
