  <diagram id="v21_1" name="v2.1 当前实现 · 身份绑定与主台账列类图">
    <mxGraphModel grid="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1100">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Valenbot v2.1 · 实际实现类图&#10;SN 主键兼容保留；新增稳定 UUID 绑定；客户名称不参与普通用户权限判断。" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=top;spacing=14;fillColor=#FFFFFF;strokeColor=#7187A3;fontColor=#203047;fillColor=#EAF1FE;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1380" height="85" as="geometry" />
        </mxCell>
        <mxCell id="u" value="User / sys_user&#10;username：兼容主键&#10;user_id：稳定 UUID，唯一&#10;role：三级角色&#10;active / auth_version&#10;password_hash：BCrypt" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=top;spacing=14;fillColor=#FFFFFF;strokeColor=#7187A3;fontColor=#203047;fillColor=#F3F6FA;" vertex="1" parent="1">
          <mxGeometry x="40" y="155" width="345" height="265" as="geometry" />
        </mxCell>
        <mxCell id="b" value="UserRobotBinding&#10;user_id：主键、外键&#10;robot_id：唯一外键&#10;updated_at&#10;&#10;一个普通用户最多一台机器人&#10;一台机器人最多一个普通客户账号" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=top;spacing=14;fillColor=#FFFFFF;strokeColor=#7187A3;fontColor=#203047;fillColor=#E2EFDA;" vertex="1" parent="1">
          <mxGeometry x="505" y="155" width="350" height="265" as="geometry" />
        </mxCell>
        <mxCell id="r" value="Robot / robot&#10;sn：兼容业务主键、唯一&#10;robot_id：稳定 UUID，唯一&#10;fields：JSONB（客户名称在此）&#10;revision / deleted&#10;SN 迁移保持 robot_id 不变" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=top;spacing=14;fillColor=#FFFFFF;strokeColor=#7187A3;fontColor=#203047;fillColor=#EAF1FE;" vertex="1" parent="1">
          <mxGeometry x="975" y="155" width="430" height="265" as="geometry" />
        </mxCell>
        <mxCell id="f" value="FieldDefinition / field_def&#10;key / label / data_type&#10;ordinal / required&#10;customer_visible / active&#10;storage_kind：FIELD / SN / MODULE&#10;归档展示列，不清空原值&#10;普通用户编辑权固定为 nickname" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=top;spacing=14;fillColor=#FFFFFF;strokeColor=#7187A3;fontColor=#203047;fillColor=#FFF4DF;" vertex="1" parent="1">
          <mxGeometry x="40" y="555" width="365" height="285" as="geometry" />
        </mxCell>
        <mxCell id="h" value="BindingHistory&#10;user_id&#10;old_robot_id → new_robot_id&#10;old_customer → new_customer&#10;actor_id / actor&#10;reason / occurred_at&#10;只追加历史" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=top;spacing=14;fillColor=#FFFFFF;strokeColor=#7187A3;fontColor=#203047;fillColor=#EAF1FE;" vertex="1" parent="1">
          <mxGeometry x="505" y="555" width="350" height="285" as="geometry" />
        </mxCell>
        <mxCell id="a" value="AuditLog / 原有追溯&#10;旧值 → 新值、原因、人员、时间&#10;装拆历史 / 流程记录 / 维修快照保留&#10;历史 SN 仍可解析到同一机器人&#10;所有客户端入口使用相同后端授权&#10;列定义同步影响台账、详情、表单、导出" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=top;spacing=14;fillColor=#FFFFFF;strokeColor=#7187A3;fontColor=#203047;fillColor=#F3F6FA;" vertex="1" parent="1">
          <mxGeometry x="975" y="555" width="430" height="285" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="1 → 0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=open;fontSize=13;fontFamily=Microsoft YaHei;strokeColor=#285DD4;" edge="1" parent="1" source="u" target="b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="0..1 ← 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=open;fontSize=13;fontFamily=Microsoft YaHei;strokeColor=#285DD4;" edge="1" parent="1" source="r" target="b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="绑定变更追加" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=open;fontSize=13;fontFamily=Microsoft YaHei;strokeColor=#285DD4;" edge="1" parent="1" source="b" target="h">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="当前列投影 / 验证" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=open;fontSize=13;fontFamily=Microsoft YaHei;strokeColor=#285DD4;" edge="1" parent="1" source="f" target="r">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="操作留痕" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=open;fontSize=13;fontFamily=Microsoft YaHei;strokeColor=#285DD4;" edge="1" parent="1" source="h" target="a">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
